# Copy this file to .env and fill in your credentials.
# .env is listed in .gitignore and must never be committed.

# OpenAI API key — required for dataset-building scripts and image generation
OPENAI_API_KEY=sk-...

# ElevenLabs API key — required for music generation
ELEVENLABS_API_KEY=sk_...

# Hugging Face token — required to load gated models (e.g. Llama-3.1-8B-Instruct)
HF_TOKEN=hf_...
