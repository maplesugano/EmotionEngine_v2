\@writefile{toc}{\contentsline {section}{\numberline {3.6}Steering Experiments}{26}{section.54}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3.7}{\ignorespaces Five intervention families were tested during the generation process. The decomposed family isolates the contributions of shared emotionalisation from emotion-specific residuals. In contrast, the monolithic original CAA family applies the full pooled direction as a single coefficient.}}{27}{table.caption.57}\protected@file@percent }
\newlabel{tab:steering_conditions}{{3.7}{27}{Five intervention families were tested during the generation process. The decomposed family isolates the contributions of shared emotionalisation from emotion-specific residuals. In contrast, the monolithic original CAA family applies the full pooled direction as a single coefficient}{table.caption.57}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.8}{\ignorespaces Summary of steering results. Decomposed CAA steering yields the strongest target-emotion shift while preserving semantic content. Monotonicity is present but partial, and robustness checks indicate that outputs remain constrained by the seed context.}}{28}{table.caption.61}\protected@file@percent }
\newlabel{tab:steering_results}{{3.8}{28}{Summary of steering results. Decomposed CAA steering yields the strongest target-emotion shift while preserving semantic content. Monotonicity is present but partial, and robustness checks indicate that outputs remain constrained by the seed context}{table.caption.61}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.9}{\ignorespaces Representative examples of decomposed CAA steering in the canonical setting. The fear-to-joy example shows a natural affective shift while preserving the dark-alley context. The disgust-to-joy example shows a stronger and less natural reinterpretation, illustrating both the causal effect and the contextual limits of the intervention.}}{29}{table.caption.63}\protected@file@percent }
\newlabel{tab:qualitative_steering_examples}{{3.9}{29}{Representative examples of decomposed CAA steering in the canonical setting. The fear-to-joy example shows a natural affective shift while preserving the dark-alley context. The disgust-to-joy example shows a stronger and less natural reinterpretation, illustrating both the causal effect and the contextual limits of the intervention}{table.caption.63}{}}
