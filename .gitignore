# ── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Large binary / tensor artefacts ──────────────────────────────────────────
# Residual-stream dumps and model checkpoints are tens of GBs;
# use a separate storage (HuggingFace Hub, GCS, etc.) for these.
*.pt
*.pth
*.ckpt
*.safetensors
*.npy
*.npz
*.mmap
*.pkl
*.h5
*.hdf5

# ── Archives ─────────────────────────────────────────────────────────────────
*.tar.gz
*.tar
*.zip
*.gz

# ── External / downloaded datasets ───────────────────────────────────────────
# Re-download via the original sources; not committed to keep the repo lean.
dataset/dailydialog/
dataset/empatheticdialog/
# activation/ contains >60 GB of tensor dumps — exclude entirely
activation/
# Temporary memory-mapped analysis arrays
analysis/**/*.mmap
# Intermediate shard / batch artefacts (keep the dir placeholder, ignore content)
dataset/activations_emotion_intensity/*
!dataset/activations_emotion_intensity/.gitkeep
dataset/*/batch_results/
dataset/*/returned_batch/

# ── Notebook outputs ─────────────────────────────────────────────────────────
# Rendered HTML exports of notebooks
notebook/**/*.html
# Uncomment the next two lines to also strip cell outputs from .ipynb files
# (requires nbstripout: pip install nbstripout && nbstripout --install)
# *.ipynb

# ── Logs and misc ────────────────────────────────────────────────────────────
*.log
*.pyc
Thumbs.db
.DS_Store

# cache
**/judge_cache/
**/gen_cache/

# ── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── LaTeX auxiliary files ─────────────────────────────────────────────────────
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.brf
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.out
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.synctex.gz
thesis/*.synctex(busy)
thesis/*.nav
thesis/*.snm
thesis/*.vrb
thesis/_minted*/
thesis/main.pdf

# ── Claude  ─────────────────────────────────────────────────────
.claude_cache/
.claude/